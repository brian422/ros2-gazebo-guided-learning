<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Gazebo Harmonic additions for the rover.

    This macro is called by hazard_rover.urdf.xacro only when the Xacro
    argument simulation:=true is supplied by the Module 3 launch file.
  -->
  <xacro:macro
    name="hazard_rover_gazebo"
    params="wheel_separation wheel_radius">

    <!-- Drive-wheel friction supports rolling without excessive slipping. -->
    <gazebo reference="left_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="right_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>

    <!--
      The fixed spherical caster is a simplified passive support. Low friction
      reduces drag while preserving contact with the floor.
    -->
    <gazebo reference="caster_link">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
    </gazebo>

    <!--
      A 2D GPU lidar is attached to laser_frame. Its output is Gazebo
      Transport topic /scan; ros_gz_bridge converts it to LaserScan.
    -->
    <gazebo reference="laser_frame">
      <sensor name="inspection_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/scan</topic>
        <gz_frame_id>laser_frame</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-${pi}</min_angle>
              <max_angle>${pi}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <!--
      Gazebo's educational differential-drive system converts body velocity
      commands into wheel motion and publishes wheel-derived odometry.
    -->
    <gazebo>
      <plugin
        filename="gz-sim-diff-drive-system"
        name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
        <min_linear_velocity>-0.50</min_linear_velocity>
        <max_linear_velocity>0.50</max_linear_velocity>
        <min_angular_velocity>-1.50</min_angular_velocity>
        <max_angular_velocity>1.50</max_angular_velocity>
        <min_linear_acceleration>-1.00</min_linear_acceleration>
        <max_linear_acceleration>1.00</max_linear_acceleration>
        <min_angular_acceleration>-2.50</min_angular_acceleration>
        <max_angular_acceleration>2.50</max_angular_acceleration>
      </plugin>

      <!-- Publish simulated wheel positions and velocities. -->
      <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
